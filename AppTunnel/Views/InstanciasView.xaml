<UserControl x:Class="AppTunnel.Views.InstanciasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0" Background="{DynamicResource CorPainel}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1" CornerRadius="0">
        <DockPanel Margin="0">
            <Border DockPanel.Dock="Top" Background="{DynamicResource CorPainelClaro}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,0,0,1" Margin="0">
                <StackPanel Orientation="Horizontal" Margin="10,8,10,8">
                    <ComboBox Width="220" ItemsSource="{Binding Perfis}" DisplayMemberPath="Nome" SelectedItem="{Binding PerfilSelecionado}" Margin="0,0,8,0"/>
                    <Button Command="{Binding ComandoLancar}" Width="90" Margin="0,0,8,0" Style="{StaticResource BotaoSucesso}">
                        <TextBlock Text="Lançar" Margin="0,0,0,0"/>
                    </Button>
                    <Button Click="NovoPerfil_Click" Width="110" Margin="0,0,8,0" Style="{StaticResource BotaoSecundario}">
                        <TextBlock Text="Novo perfil..." Margin="0,0,0,0"/>
                    </Button>
                    <Button Click="EditarPerfil_Click" Width="110" Margin="0,0,8,0" Style="{StaticResource BotaoBorda}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Editar perfil..." Margin="0,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Click="RemoverPerfil_Click" Width="110" Style="{StaticResource BotaoPerigo}">
                        <StackPanel Orientation="Horizontal">
							<TextBlock Margin="0,0,0,0"><Run Text="Remov"/><Run Language="pt-br" Text="er"/></TextBlock>
						</StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Linhas}" SelectedItem="{Binding LinhaSelecionada}"
                      AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}"/>
                    <DataGridTextColumn Header="Proxy ativo" Binding="{Binding ProxyAtual}"/>
                    <DataGridTextColumn Header="Conexões ativas" Binding="{Binding ConexoesAtivas}"/>
                    <DataGridTextColumn Header="Falhas" Binding="{Binding Falhas}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
