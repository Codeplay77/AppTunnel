<UserControl x:Class="AppTunnel.Views.ProxiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button Content="Testar todos" Command="{Binding ComandoTestarTodos}" Width="110"/>
        </StackPanel>

        <Expander DockPanel.Dock="Top" Header="Editar lista de proxies (host:porta:usuario:senha, uma por linha)" Margin="8,0,8,8">
            <DockPanel Margin="0,8,0,0">
                <Button Content="Salvar lista" Command="{Binding ComandoSalvarLista}"
                        DockPanel.Dock="Bottom" HorizontalAlignment="Right" Width="110" Margin="0,8,0,0"/>
                <TextBox Text="{Binding TextoLista, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" Height="160"/>
            </DockPanel>
        </Expander>

        <DataGrid ItemsSource="{Binding Linhas}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Host:Porta" Binding="{Binding HostPorta}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                <DataGridTextColumn Header="Latência (ms)" Binding="{Binding LatenciaMs}"/>
                <DataGridTextColumn Header="Em uso por" Binding="{Binding EmUsoPor}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
