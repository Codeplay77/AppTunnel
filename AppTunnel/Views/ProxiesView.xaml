<UserControl x:Class="AppTunnel.Views.ProxiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="0">
        <Border DockPanel.Dock="Top" Background="{DynamicResource CorPainelClaro}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="0,0,0,1" Margin="0">
            <StackPanel Orientation="Horizontal" Margin="10,8,10,8">
                <Button Command="{Binding ComandoTestarTodos}" Width="120" Style="{StaticResource BotaoPrimario}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Testar todos" Margin="0,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Expander DockPanel.Dock="Top" Header="Editar lista de proxies (host:porta:usuario:senha, uma por linha)" Margin="0" Background="{DynamicResource CorPainel}" BorderBrush="{DynamicResource CorBorda}">
            <DockPanel Margin="0,8,0,0">
                <Button Command="{Binding ComandoSalvarLista}"
                        DockPanel.Dock="Bottom" HorizontalAlignment="Right" Width="110" Margin="0,8,0,0" Style="{StaticResource BotaoPrimario}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M0,0 L0,8 L8,8 L8,0 Z M2,4 L6,4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
                        <TextBlock Text="Salvar lista" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <TextBox Text="{Binding TextoLista, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" Height="160"/>
            </DockPanel>
        </Expander>

        <Border Background="{DynamicResource CorPainel}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1,0,1,1" CornerRadius="0">
            <DataGrid ItemsSource="{Binding Linhas}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0" BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Host:Porta" Binding="{Binding HostPorta}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                    <DataGridTextColumn Header="Latência (ms)" Binding="{Binding LatenciaMs}"/>
                    <DataGridTextColumn Header="Em uso por" Binding="{Binding EmUsoPor}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
