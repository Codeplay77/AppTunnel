<Window x:Class="AppTunnel.Views.NovoPerfilWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo perfil" Height="640" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource CorGradientePrincipal}" Foreground="{DynamicResource CorTextoPrimario}">
    <Border Margin="16" Background="{DynamicResource CorPainel}" BorderBrush="{DynamicResource CorBorda}" BorderThickness="1" CornerRadius="18">
        <DockPanel Margin="18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button Width="90" Margin="0,0,8,0" Click="Cancelar_Click" IsCancel="True" Style="{StaticResource BotaoBorda}">
                    <TextBlock Text="Cancelar"/>
                </Button>
                <Button Width="90" Click="Salvar_Click" IsDefault="True" Style="{StaticResource BotaoSucesso}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Salvar" Margin="0,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <TextBlock Text="ID do perfil" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtId" Margin="0,0,0,12"/>

                    <TextBlock Text="Nome do perfil" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtNome" Margin="0,0,0,12"/>

                    <TextBlock Text="Executável" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Width="96" Click="ProcurarExe_Click" Style="{StaticResource BotaoBorda}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Procurar..." Margin="0,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="TxtExe" Margin="0,0,8,0"/>
                    </DockPanel>

                    <TextBlock Text="Argumentos (opcional)" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtArgs" Margin="0,0,0,12"/>

                    <TextBlock Text="Diretório de trabalho" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Width="96" Click="ProcurarDir_Click" Style="{StaticResource BotaoBorda}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Procurar..." Margin="0,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="TxtDir" Margin="0,0,8,0"/>
                    </DockPanel>

                    <TextBlock Text="Proxy principal" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbProxyPrincipal" Margin="0,0,0,12" DisplayMemberPath="Rotulo"/>

                    <TextBlock Text="Proxies de reserva (opcional — Ctrl+clique para selecionar vários)" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <ListBox x:Name="LstReservas" Height="90" SelectionMode="Multiple" DisplayMemberPath="Rotulo" Margin="0,0,0,12"/>

                    <TextBlock Text="IPs de passthrough" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBox x:Name="TxtPassthrough" Height="70" Margin="0,0,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="Opcional, um por linha, sem espaços. Exemplo: 192.168.0.0/24:80-443" FontSize="10" Foreground="{DynamicResource CorTextoSecundario}" Margin="0,4,0,12"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
