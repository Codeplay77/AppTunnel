<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>AppTunnel</RootNamespace>
    <AssemblyName>AppTunnel</AssemblyName>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <!-- WPF precisa de dados de cultura reais para binding (StringFormat, XmlLanguage) —
         InvariantGlobalization quebra o Window.Show() com XmlLanguage.GetSpecificCulture(). -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\nativo\WinDivert.dll" Link="WinDivert.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\nativo\WinDivert64.sys" Link="WinDivert64.sys" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="favicon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
